ch  69/100  train=4.1400e-09  val=3.8554e-09  lr=2.19e-04  (28.2s)\n","Epoch  70/100  train=4.1435e-09  val=4.1989e-09  lr=2.06e-04  (28.2s)\n","Epoch  71/100  train=4.1667e-09  val=6.2247e-09  lr=1.94e-04  (28.2s)\n","Epoch  72/100  train=3.8665e-09  val=3.9226e-09  lr=1.81e-04  (28.2s)\n","Epoch  73/100  train=3.7784e-09  val=3.8250e-09  lr=1.69e-04  (28.2s)\n","Epoch  74/100  train=3.7281e-09  val=4.3453e-09  lr=1.58e-04  (28.2s)\n","Epoch  75/100  train=3.6182e-09  val=3.6468e-09  lr=1.46e-04  (28.2s)\n","Epoch  76/100  train=3.5823e-09  val=4.5239e-09  lr=1.36e-04  (28.2s)\n","Epoch  77/100  train=3.4426e-09  val=3.5686e-09  lr=1.25e-04  (28.2s)\n","Epoch  78/100  train=3.4206e-09  val=3.5552e-09  lr=1.15e-04  (28.2s)\n","Epoch  79/100  train=3.3142e-09  val=3.4938e-09  lr=1.05e-04  (28.2s)\n","Epoch  80/100  train=3.3165e-09  val=4.1564e-09  lr=9.55e-05  (28.2s)\n","Epoch  81/100  train=3.2623e-09  val=3.5706e-09  lr=8.65e-05  (28.2s)\n","Epoch  82/100  train=3.2193e-09  val=3.4344e-09  lr=7.78e-05  (28.2s)\n","Epoch  83/100  train=3.1973e-09  val=3.4934e-09  lr=6.96e-05  (28.2s)\n","Epoch  84/100  train=3.1639e-09  val=3.4697e-09  lr=6.18e-05  (28.2s)\n","Epoch  85/100  train=3.1497e-09  val=3.3494e-09  lr=5.45e-05  (28.2s)\n","Epoch  86/100  train=3.1230e-09  val=3.3365e-09  lr=4.76e-05  (28.2s)\n","Epoch  87/100  train=3.1212e-09  val=3.3284e-09  lr=4.11e-05  (28.2s)\n","Epoch  88/100  train=3.1001e-09  val=3.3056e-09  lr=3.51e-05  (28.2s)\n","Epoch  89/100  train=3.0878e-09  val=3.3023e-09  lr=2.96e-05  (28.2s)\n","Epoch  90/100  train=3.0737e-09  val=3.2878e-09  lr=2.45e-05  (28.2s)\n","Epoch  91/100  train=3.0641e-09  val=3.2837e-09  lr=1.99e-05  (28.2s)\n","Epoch  92/100  train=3.0564e-09  val=3.2723e-09  lr=1.57e-05  (28.2s)\n","Epoch  93/100  train=3.0513e-09  val=3.2652e-09  lr=1.20e-05  (28.2s)\n","Epoch  94/100  train=3.0449e-09  val=3.2617e-09  lr=8.86e-06  (28.3s)\n","Epoch  95/100  train=3.0457e-09  val=3.2577e-09  lr=6.16e-06  (28.2s)\n","Epoch  96/100  train=3.0444e-09  val=3.2554e-09  lr=3.94e-06  (28.2s)\n","Epoch  97/100  train=3.0375e-09  val=3.2538e-09  lr=2.22e-06  (28.2s)\n","Epoch  98/100  train=3.0447e-09  val=3.2531e-09  lr=9.87e-07  (28.2s)\n","Epoch  99/100  train=3.0350e-09  val=3.2524e-09  lr=2.47e-07  (28.2s)\n","Epoch 100/100  train=3.0351e-09  val=3.2521e-09  lr=0.00e+00  (28.2s)\n","\n","Best val loss: 3.2521e-09\n","\n","[4/4] Evaluating...\n","\n","============================================================\n","ROLLOUT RESULTS (100 steps)\n","============================================================\n","  step    F_classical        F_model          MSE\n","     0       4157.521       4157.521     0.00e+00\n","    25       4104.500       4104.506     7.40e-06\n","    50       4099.764       4099.795     9.31e-06\n","   100       4097.286       4097.335     1.09e-05\n","\n","Saved 4 figures: eval_phase_separation.png, eval_free_energy.png, eval_mass.png, eval_mse.png\n","\n","============================================================\n","DONE\n","============================================================\n","Next: implement the structure-preserving architecture in sp_stencil.py\n"]}],"source":["\"\"\"\n","Cahn-Hilliard neural stencil pipeline — single-file version for Kaggle/Colab.\n","\n","Pipeline:\n","  1. Define classical solver, free energy, mass, CNN stencil\n","  2. Generate training data\n","  3. Train CNN stencil baseline\n","  4. Evaluate: rollout vs classical, free energy drift, mass conservation\n","  5. Save 4 figures\n","\"\"\"\n","\n","import torch\n","import torch.nn as nn\n","import torch.fft as fft\n","from torch.utils.data import DataLoader, Dataset\n","import matplotlib\n","matplotlib.use('Agg')\n","import matplotlib.pyplot as plt\n","import numpy as np\n","import time\n","import os\n","\n","# CONFIGURATION — flip MODE to switch between quick test and real training\n","MODE = 'kaggle'  # 'test' for quick CPU run, 'kaggle' for real GPU training\n","\n","if MODE == 'test':\n","    N_TRAJ     = 10\n","    TRAJ_LEN   = 100\n","    N_GRID     = 64\n","    N_EPOCHS   = 20\n","    BATCH_SIZE = 32\n","else:  # kaggle\n","    N_TRAJ     = 50\n","    TRAJ_LEN   = 500\n","    N_GRID     = 128\n","    N_EPOCHS   = 100\n","    BATCH_SIZE = 64\n","\n","DT    = 1e-3\n","M     = 1.0\n","EPS   = 1.0\n","LR    = 1e-3\n","DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n","\n","print(f\"Mode: {MODE}\")\n","print(f\"Device: {DEVICE}\")\n","print(f\"Config: {N_TRAJ} traj x {TRAJ_LEN} steps, grid {N_GRID}x{N_GRID}, {N_EPOCHS} epochs\")\n","print()\n","\n","\n","# 1. Cahn-Hilliard semi-implicit Fourier solver\n","\n","\n","def cahn_hilliard_solver(c0, n_steps, dt=DT, M=M, eps=EPS, device=DEVICE):\n","    \"\"\"\n","    Semi-implicit Fourier solver for 2D Cahn-Hilliard.\n","    Equation: dc/dt = M * laplacian(mu),  mu = -eps^2 lap(c) + c^3 - c\n","    Scheme:   c_hat^{n+1} = (c_hat^n - dt*M*k^2*fprime_hat^n) / (1 + dt*M*eps^2*k^4)\n","    \"\"\"\n","    B, _, N, _ = c0.shape\n","    c = c0.clone().to(device)\n","    k = 2.0 * torch.pi * torch.fft.fftfreq(N, d=1.0).to(device)\n","    kx, ky = torch.meshgrid(k, k, indexing='ij')\n","    k2 = kx**2 + ky**2\n","    k4 = k2**2\n","    denom = 1.0 + dt * M * (eps ** 2) * k4\n","    trajectory = [c]\n","    for _ in range(n_steps):\n","        fprime = c**3 - c\n","        c_hat = fft.fft2(c)\n","        fprime_hat = fft.fft2(fprime)\n","        c_new_hat = (c_hat - dt * M * k2 * fprime_hat) / denom\n","        c = fft.ifft2(c_new_hat).real\n","        trajectory.append(c)\n","    return torch.stack(trajectory, dim=0)\n","\n","\n","def free_energy(c, eps=EPS):\n","    \"\"\"Ginzburg-Landau free energy F[c] = integral [(eps^2/2)|grad c|^2 + (1/4)(c^2-1)^2] dx.\"\"\"\n","    cx = c[:, :, :, 1:] - c[:, :, :, :-1]\n","    cy = c[:, :, 1:, :] - c[:, :, :-1, :]\n","    grad_term = 0.5 * (eps**2) * ((cx**2).sum(dim=(-1,-2)) + (cy**2).sum(dim=(-1,-2)))\n","    well_term = 0.25 * ((c**2 - 1)**2).sum(dim=(-1,-2))\n","    return (grad_term + well_term).squeeze(-1)\n","\n","\n","def total_mass(c):\n","    return c.sum(dim=(-1,-2,-3))\n","\n","\n","# 2. CNN stencil baseline\n","\n","\n","class CNNStencil(nn.Module):\n","    \"\"\"Vanilla CNN stencil. Predicts c(t+dt) from c(t). No structure preservation.\"\"\"\n","    def __init__(self, stencil_size=5, channels=16, n_layers=3):\n","        super().__init__()\n","        pad = stencil_size // 2\n","        layers = []\n","        in_ch = 1\n","        for _ in range(n_layers):\n","            layers.append(nn.Conv2d(in_ch, channels, stencil_size, padding=pad))\n","            layers.append(nn.GELU())\n","            in_ch = channels\n","        layers.append(nn.Conv2d(in_ch, 1, stencil_size, padding=pad))\n","        self.net = nn.Sequential(*layers)\n","    def forward(self, c):\n","        return self.net(c)\n","\n","\n","def rollout(model, c0, n_steps):\n","    trajectory = [c0]\n","    c = c0\n","    with torch.no_grad():\n","        for _ in range(n_steps):\n","            c = model(c)\n","            trajectory.append(c)\n","    return torch.stack(trajectory, dim=0)\n","\n","\n","# 3. Data generation\n","\n","\n","def generate_dataset(n_traj=N_TRAJ, traj_len=TRAJ_LEN, N=N_GRID, dt=DT, M=M, eps=EPS, seed=0):\n","    torch.manual_seed(seed)\n","    trajectories = []\n","    for _ in range(n_traj):\n","        c0 = 0.05 * torch.randn(1, 1, N, N)\n","        traj = cahn_hilliard_solver(c0, n_steps=traj_len, dt=dt, M=M, eps=eps)\n","        trajectories.append(traj[:, 0])\n","    return torch.stack(trajectories, dim=0)  # (n_traj, traj_len+1, 1, N, N)\n","\n","\n","class CHDataset(Dataset):\n","    def __init__(self, trajectories):\n","        self.traj = trajectories\n","        n_traj, T = trajectories.shape[:2]\n","        self.indices = [(i, t) for i in range(n_traj) for t in range(T - 1)]\n","    def __len__(self):\n","        return len(self.indices)\n","    def __getitem__(self, idx):\n","        i, t = self.indices[idx]\n","        return self.traj[i, t], self.traj[i, t + 1]\n","\n","\n","\n","# 4. Training\n","\n","\n","def train_model(model, train_loader, val_loader, n_epochs=N_EPOCHS, lr=LR,\n","                device=DEVICE, save_path='cnn_stencil.pt'):\n","    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n","    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=n_epochs)\n","    best_val = float('inf')\n","    for epoch in range(n_epochs):\n","        t0 = time.time()\n","        model.train()\n","        train_loss, n_b = 0.0, 0\n","        for c_t, c_tp1 in train_loader:\n","            c_t, c_tp1 = c_t.to(device), c_tp1.to(device)\n","            pred = model(c_t)\n","            loss = ((pred - c_tp1) ** 2).mean()\n","            optimizer.zero_grad(); loss.backward(); optimizer.step()\n","            train_loss += loss.item(); n_b += 1\n","        train_loss /= n_b\n","        model.eval()\n","        val_loss, n_v = 0.0, 0\n","        with torch.no_grad():\n","            for c_t, c_tp1 in val_loader:\n","                c_t, c_tp1 = c_t.to(device), c_tp1.to(device)\n","                pred = model(c_t)\n","                val_loss += ((pred - c_tp1) ** 2).mean().item(); n_v += 1\n","        val_loss /= n_v\n","        scheduler.step()\n","        if val_loss < best_val:\n","            best_val = val_loss\n","            torch.save(model.state_dict(), save_path)\n","        print(f\"Epoch {epoch+1:3d}/{n_epochs}  train={train_loss:.4e}  val={val_loss:.4e}  \"\n","              f\"lr={scheduler.get_last_lr()[0]:.2e}  ({time.time()-t0:.1f}s)\")\n","    print(f\"\\nBest val loss: {best_val:.4e}\")\n","    return model\n","\n","\n","\n","# 5. Evaluation\n","\n","\n","def evaluate_and_plot(model, n_steps=100, device=DEVICE, out_dir='.'):\n","    N = N_GRID\n","    torch.manual_seed(999)  # held-out IC\n","    c0 = 0.05 * torch.randn(1, 1, N, N)\n","\n","    # Ground truth\n","    classical_traj = cahn_hilliard_solver(c0, n_steps=n_steps)[:, 0].cpu()\n","    # Model rollout\n","    model_traj = rollout(model, c0.to(device), n_steps=n_steps).cpu()[:, 0]\n","\n","    F_c = free_energy(classical_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n","    F_m = free_energy(model_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n","    mc = total_mass(classical_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n","    mm = total_mass(model_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n","    mse = ((model_traj - classical_traj)**2).mean(dim=(-1,-2,-3)).numpy()\n","\n","    # Print summary\n","    print(f\"\\n{'='*60}\")\n","    print(f\"ROLLOUT RESULTS ({n_steps} steps)\")\n","    print(f\"{'='*60}\")\n","    print(f\"{'step':>6} {'F_classical':>14} {'F_model':>14} {'MSE':>12}\")\n","    for t in [0, n_steps//4, n_steps//2, n_steps]:\n","        print(f\"{t:>6} {F_c[t]:>14.3f} {F_m[t]:>14.3f} {mse[t]:>12.2e}\")\n","\n","    # ---- Figure 1: phase separation ----\n","    fig, axes = plt.subplots(2, 4, figsize=(14, 6))\n","    times = [0, n_steps//4, n_steps//2, n_steps]\n","    for j, t in enumerate(times):\n","        axes[0, j].imshow(classical_traj[t, 0].numpy(), cmap='RdBu_r', vmin=-1, vmax=1)\n","        axes[0, j].set_title(f'Classical t={t}')\n","        axes[1, j].imshow(model_traj[t, 0].numpy(), cmap='RdBu_r', vmin=-1, vmax=1)\n","        axes[1, j].set_title(f'CNN stencil t={t}')\n","        for ax in axes[:, j]:\n","            ax.set_xticks([]); ax.set_yticks([])\n","    plt.suptitle('Phase separation: classical vs CNN stencil', y=1.02)\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(out_dir, 'eval_phase_separation.png'), dpi=120, bbox_inches='tight')\n","    plt.close()\n","\n","    # ---- Figure 2: free energy drift (HEADLINE) ----\n","    fig, ax = plt.subplots(figsize=(8, 5))\n","    ax.plot(F_c, 'b-', linewidth=2, label='Classical (ground truth)')\n","    ax.plot(F_m, 'r-', linewidth=2, label='CNN stencil (baseline)')\n","    ax.set_xlabel('time step', fontsize=12)\n","    ax.set_ylabel('free energy F[c]', fontsize=12)\n","    ax.set_title('Free energy: classical vs CNN stencil\\n(CNN should violate dissipation law)', fontsize=12)\n","    ax.legend(fontsize=11); ax.grid(True, alpha=0.3)\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(out_dir, 'eval_free_energy.png'), dpi=120, bbox_inches='tight')\n","    plt.close()\n","\n","    # ---- Figure 3: mass ----\n","    fig, ax = plt.subplots(figsize=(8, 5))\n","    ax.plot(mc - mc[0], 'b-', linewidth=2, label='Classical')\n","    ax.plot(mm - mm[0], 'r-', linewidth=2, label='CNN stencil')\n","    ax.set_xlabel('time step', fontsize=12)\n","    ax.set_ylabel('mass drift', fontsize=12)\n","    ax.set_title('Mass conservation', fontsize=12)\n","    ax.legend(fontsize=11); ax.grid(True, alpha=0.3)\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(out_dir, 'eval_mass.png'), dpi=120, bbox_inches='tight')\n","    plt.close()\n","\n","    # ---- Figure 4: MSE ----\n","    fig, ax = plt.subplots(figsize=(8, 5))\n","    ax.plot(mse, 'k-', linewidth=2)\n","    ax.set_xlabel('time step', fontsize=12)\n","    ax.set_ylabel('MSE vs classical', fontsize=12)\n","    ax.set_title('Rollout error growth', fontsize=12)\n","    ax.set_yscale('log'); ax.grid(True, alpha=0.3)\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(out_dir, 'eval_mse.png'), dpi=120, bbox_inches='tight')\n","    plt.close()\n","    print(f\"\\nSaved 4 figures: eval_phase_separation.png, eval_free_energy.png, eval_mass.png, eval_mse.png\")\n","\n","\n","# MAIN PIPELINE\n","\n","\n","def main():\n","    print(\"=\"*60)\n","    print(\"CAHN-HILLIARD CNN STENCIL PIPELINE\")\n","    print(\"=\"*60)\n","\n","    # Generate data\n","    print(\"\\n[1/4] Generating dataset...\")\n","    t0 = time.time()\n","    data = generate_dataset()\n","    print(f\"  Dataset shape: {tuple(data.shape)}  ({time.time()-t0:.1f}s)\")\n","    n_val = max(1, int(len(data) * 0.2))\n","    train_data, val_data = data[n_val:], data[:n_val]\n","    train_ds = CHDataset(train_data)\n","    val_ds   = CHDataset(val_data)\n","    train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)\n","    val_loader   = DataLoader(val_ds,   batch_size=BATCH_SIZE, shuffle=False)\n","    print(f\"  Train: {len(train_data)} traj ({len(train_ds)} pairs)\")\n","    print(f\"  Val:   {len(val_data)} traj ({len(val_ds)} pairs)\")\n","\n","    # Model\n","    print(\"\\n[2/4] Building model...\")\n","    model = CNNStencil(stencil_size=5, channels=16, n_layers=3).to(DEVICE)\n","    n_params = sum(p.numel() for p in model.parameters())\n","    print(f\"  CNNStencil: {n_params:,} parameters\")\n","\n","    # Train\n","    print(f\"\\n[3/4] Training ({N_EPOCHS} epochs)...\")\n","    model = train_model(model, train_loader, val_loader)\n","\n","    # Load best and evaluate\n","    print(f\"\\n[4/4] Evaluating...\")\n","    model.load_state_dict(torch.load('cnn_stencil.pt', map_location=DEVICE, weights_only=True))\n","    evaluate_and_plot(model, n_steps=100, out_dir='.')\n","\n","    print(\"\\n\" + \"=\"*60)\n","    print(\"DONE\")\n","    print(\"=\"*60)\n","    print(\"Next: implement the structure-preserving architecture in sp_stencil.py\")\n","\n","\n","if __name__ == \"__main__\":\n","    main()\n"]},{"cell_type":"code","execution_count":3,"id":"d4ea8f41","metadata":{"execution":{"iopub.execute_input":"2026-11-04T08:46:58.920601Z","iopub.status.busy":"2026-11-04T08:46:58.920225Z","iopub.status.idle":"2026-11-04T08:46:58.936168Z","shell.execute_reply":"2026-11-04T08:46:58.935256Z"},"papermill":{"duration":0.022837,"end_time":"2026-11-04T08:46:58.937608+00:00","exception":false,"start_time":"2026-11-04T08:46:58.914771+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["evaluate_and_plot redefined with .cpu() fix.\n"]}],"source":["# Redefine evaluate_and_plot with the .cpu() fix\n","\n","\n","def evaluate_and_plot(model, n_steps=100, device=DEVICE, out_dir='.')