{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.16","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# Structure-Preserving Neural Stencils for Cahn–Hilliard\n\n**Run order:**\n1. Cell 1 → trains vanilla CNN baseline, saves `cnn_stencil.pt` + 4 `eval_*.png` figures\n2. Cell 2 → trains SP stencil, loads `cnn_stencil.pt`, saves `sp_stencil.pt` + 4 `comparison_*.png` figures\n3. Cell 3 → zips everything for download\n\n**Expected wall time on Tesla T4:** ~25 min (Cell 1: ~12 min, Cell 2: ~12 min, eval: ~1 min)\n\nMake sure GPU is enabled: Settings → Accelerator → GPU T4 x2 (or P100).","metadata":{}},{"cell_type":"code","source":"\"\"\"\nCahn-Hilliard neural stencil pipeline — single-file version for Kaggle/Colab.\n\nPaste this entire file into one notebook cell. Set MODE='kaggle' for real\ntraining on GPU, or MODE='test' for a quick CPU sanity check.\n\nPipeline:\n  1. Define classical solver, free energy, mass, CNN stencil\n  2. Generate training data\n  3. Train CNN stencil baseline\n  4. Evaluate: rollout vs classical, free energy drift, mass conservation\n  5. Save 4 figures\n\"\"\"\n\nimport torch\nimport torch.nn as nn\nimport torch.fft as fft\nfrom torch.utils.data import DataLoader, Dataset\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport time\nimport os\n\n# ============================================================\n# CONFIGURATION — flip MODE to switch between quick test and real training\n# ============================================================\nMODE = 'kaggle'  # 'test' for quick CPU run, 'kaggle' for real GPU training\n\nif MODE == 'test':\n    N_TRAJ     = 10\n    TRAJ_LEN   = 100\n    N_GRID     = 64\n    N_EPOCHS   = 20\n    BATCH_SIZE = 32\nelse:  # kaggle\n    N_TRAJ     = 50\n    TRAJ_LEN   = 500\n    N_GRID     = 128\n    N_EPOCHS   = 100\n    BATCH_SIZE = 64\n\nDT    = 1e-3\nM     = 1.0\nEPS   = 1.0\nLR    = 1e-3\nDEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n\nprint(f\"Mode: {MODE}\")\nprint(f\"Device: {DEVICE}\")\nprint(f\"Config: {N_TRAJ} traj x {TRAJ_LEN} steps, grid {N_GRID}x{N_GRID}, {N_EPOCHS} epochs\")\nprint()\n\n# ============================================================\n# 1. Cahn-Hilliard semi-implicit Fourier solver\n# ============================================================\n\ndef cahn_hilliard_solver(c0, n_steps, dt=DT, M=M, eps=EPS, device=DEVICE):\n    \"\"\"\n    Semi-implicit Fourier solver for 2D Cahn-Hilliard.\n    Equation: dc/dt = M * laplacian(mu),  mu = -eps^2 lap(c) + c^3 - c\n    Scheme:   c_hat^{n+1} = (c_hat^n - dt*M*k^2*fprime_hat^n) / (1 + dt*M*eps^2*k^4)\n    \"\"\"\n    B, _, N, _ = c0.shape\n    c = c0.clone().to(device)\n    k = 2.0 * torch.pi * torch.fft.fftfreq(N, d=1.0).to(device)\n    kx, ky = torch.meshgrid(k, k, indexing='ij')\n    k2 = kx**2 + ky**2\n    k4 = k2**2\n    denom = 1.0 + dt * M * (eps ** 2) * k4\n    trajectory = [c]\n    for _ in range(n_steps):\n        fprime = c**3 - c\n        c_hat = fft.fft2(c)\n        fprime_hat = fft.fft2(fprime)\n        c_new_hat = (c_hat - dt * M * k2 * fprime_hat) / denom\n        c = fft.ifft2(c_new_hat).real\n        trajectory.append(c)\n    return torch.stack(trajectory, dim=0)\n\n\ndef free_energy(c, eps=EPS):\n    \"\"\"Ginzburg-Landau free energy F[c] = integral [(eps^2/2)|grad c|^2 + (1/4)(c^2-1)^2] dx.\"\"\"\n    cx = c[:, :, :, 1:] - c[:, :, :, :-1]\n    cy = c[:, :, 1:, :] - c[:, :, :-1, :]\n    grad_term = 0.5 * (eps**2) * ((cx**2).sum(dim=(-1,-2)) + (cy**2).sum(dim=(-1,-2)))\n    well_term = 0.25 * ((c**2 - 1)**2).sum(dim=(-1,-2))\n    return (grad_term + well_term).squeeze(-1)\n\n\ndef total_mass(c):\n    return c.sum(dim=(-1,-2,-3))\n\n\n# ============================================================\n# 2. CNN stencil baseline\n# ============================================================\n\nclass CNNStencil(nn.Module):\n    \"\"\"Vanilla CNN stencil. Predicts c(t+dt) from c(t). No structure preservation.\"\"\"\n    def __init__(self, stencil_size=5, channels=16, n_layers=3):\n        super().__init__()\n        pad = stencil_size // 2\n        layers = []\n        in_ch = 1\n        for _ in range(n_layers):\n            layers.append(nn.Conv2d(in_ch, channels, stencil_size, padding=pad))\n            layers.append(nn.GELU())\n            in_ch = channels\n        layers.append(nn.Conv2d(in_ch, 1, stencil_size, padding=pad))\n        self.net = nn.Sequential(*layers)\n    def forward(self, c):\n        return self.net(c)\n\n\ndef rollout(model, c0, n_steps):\n    trajectory = [c0]\n    c = c0\n    with torch.no_grad():\n        for _ in range(n_steps):\n            c = model(c)\n            trajectory.append(c)\n    return torch.stack(trajectory, dim=0)\n\n\n# ============================================================\n# 3. Data generation\n# ============================================================\n\ndef generate_dataset(n_traj=N_TRAJ, traj_len=TRAJ_LEN, N=N_GRID, dt=DT, M=M, eps=EPS, seed=0):\n    torch.manual_seed(seed)\n    trajectories = []\n    for _ in range(n_traj):\n        c0 = 0.05 * torch.randn(1, 1, N, N)\n        traj = cahn_hilliard_solver(c0, n_steps=traj_len, dt=dt, M=M, eps=eps)\n        trajectories.append(traj[:, 0])\n    return torch.stack(trajectories, dim=0)  # (n_traj, traj_len+1, 1, N, N)\n\n\nclass CHDataset(Dataset):\n    def __init__(self, trajectories):\n        self.traj = trajectories\n        n_traj, T = trajectories.shape[:2]\n        self.indices = [(i, t) for i in range(n_traj) for t in range(T - 1)]\n    def __len__(self):\n        return len(self.indices)\n    def __getitem__(self, idx):\n        i, t = self.indices[idx]\n        return self.traj[i, t], self.traj[i, t + 1]\n\n\n# ============================================================\n# 4. Training\n# ============================================================\n\ndef train_model(model, train_loader, val_loader, n_epochs=N_EPOCHS, lr=LR,\n                device=DEVICE, save_path='cnn_stencil.pt'):\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=n_epochs)\n    best_val = float('inf')\n    for epoch in range(n_epochs):\n        t0 = time.time()\n        model.train()\n        train_loss, n_b = 0.0, 0\n        for c_t, c_tp1 in train_loader:\n            c_t, c_tp1 = c_t.to(device), c_tp1.to(device)\n            pred = model(c_t)\n            loss = ((pred - c_tp1) ** 2).mean()\n            optimizer.zero_grad(); loss.backward(); optimizer.step()\n            train_loss += loss.item(); n_b += 1\n        train_loss /= n_b\n        model.eval()\n        val_loss, n_v = 0.0, 0\n        with torch.no_grad():\n            for c_t, c_tp1 in val_loader:\n                c_t, c_tp1 = c_t.to(device), c_tp1.to(device)\n                pred = model(c_t)\n                val_loss += ((pred - c_tp1) ** 2).mean().item(); n_v += 1\n        val_loss /= n_v\n        scheduler.step()\n        if val_loss < best_val:\n            best_val = val_loss\n            torch.save(model.state_dict(), save_path)\n        print(f\"Epoch {epoch+1:3d}/{n_epochs}  train={train_loss:.4e}  val={val_loss:.4e}  \"\n              f\"lr={scheduler.get_last_lr()[0]:.2e}  ({time.time()-t0:.1f}s)\")\n    print(f\"\\nBest val loss: {best_val:.4e}\")\n    return model\n\n\n# ============================================================\n# 5. Evaluation\n# ============================================================\n\ndef evaluate_and_plot(model, n_steps=500, device=DEVICE, out_dir='.'):\n    \"\"\"Catastrophic-divergence evaluation: larger IC, longer rollout, dual-panel free energy.\"\"\"\n    N = N_GRID\n    torch.manual_seed(999)  # held-out IC\n    c0 = 0.2 * torch.randn(1, 1, N, N)   # larger amplitude -> visible phase separation\n\n    # Ground truth (move to CPU after generation; .numpy() requires CPU tensor)\n    classical_traj = cahn_hilliard_solver(c0, n_steps=n_steps)[:, 0].cpu()\n    # Model rollout\n    model_traj = rollout(model, c0.to(device), n_steps=n_steps).cpu()[:, 0]\n\n    F_c = free_energy(classical_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    F_m_raw = free_energy(model_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    mc = total_mass(classical_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    mm_raw = total_mass(model_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    mse = ((model_traj - classical_traj)**2).mean(dim=(-1,-2,-3)).numpy()\n\n    # Clip infs for plotting (keep originals for printing)\n    F_m = np.where(np.isfinite(F_m_raw), F_m_raw, np.nan)\n    mm  = np.where(np.isfinite(mm_raw), mm_raw, np.nan)\n    mse_plot = np.where(np.isfinite(mse) & (mse > 0), mse, np.nan)\n\n    # Print summary\n    print(f\"\\n{'='*70}\")\n    print(f\"ROLLOUT RESULTS ({n_steps} steps, IC amplitude 0.2)\")\n    print(f\"{'='*70}\")\n    print(f\"{'step':>6} {'F_classical':>14} {'F_model':>14} {'mass_cl_drift':>16} {'mass_mdl_drift':>16} {'MSE':>12}\")\n    for t in [0, n_steps//10, n_steps//4, n_steps//2, 3*n_steps//4, n_steps]:\n        f_m_str = f\"{F_m_raw[t]:.3e}\" if np.isfinite(F_m_raw[t]) else \"inf\"\n        mm_str  = f\"{mm_raw[t]-mm_raw[0]:.3e}\"\n        mse_str = f\"{mse[t]:.2e}\" if np.isfinite(mse[t]) else \"inf\"\n        print(f\"{t:>6} {F_c[t]:>14.3f} {f_m_str:>14} {mc[t]-mc[0]:>16.3e} {mm_str:>16} {mse_str:>12}\")\n\n    # ---- Figure 1: phase separation ----\n    fig, axes = plt.subplots(2, 4, figsize=(14, 6))\n    times = [0, n_steps//10, n_steps//4, n_steps//2]\n    for j, t in enumerate(times):\n        axes[0, j].imshow(classical_traj[t, 0].numpy(), cmap='RdBu_r', vmin=-1, vmax=1)\n        axes[0, j].set_title(f'Classical  t={t}')\n        axes[1, j].imshow(np.clip(model_traj[t, 0].numpy(), -1, 1), cmap='RdBu_r', vmin=-1, vmax=1)\n        axes[1, j].set_title(f'CNN stencil  t={t}')\n        for ax in axes[:, j]:\n            ax.set_xticks([]); ax.set_yticks([])\n    plt.suptitle('Phase separation: classical vs CNN stencil (IC amplitude 0.2)', y=1.02, fontsize=13)\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'eval_phase_separation.png'), dpi=120, bbox_inches='tight')\n    plt.close()\n\n    # ---- Figure 2: free energy drift (HEADLINE) — dual panel for clarity ----\n    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5.5))\n    # Left: log scale, both curves visible\n    ax1.semilogy(np.arange(len(F_c))+1, np.maximum(F_c, 1e-3), 'b-', linewidth=2.5, label='Classical (ground truth)')\n    F_m_log = np.where(np.isfinite(F_m_raw) & (F_m_raw > 0), F_m_raw, np.nan)\n    ax1.semilogy(F_m_log, 'r-', linewidth=2.5, label='CNN stencil (baseline)')\n    ax1.set_xlabel('time step', fontsize=12)\n    ax1.set_ylabel('free energy F[c]  (log scale)', fontsize=12)\n    ax1.set_title('Free energy: log scale\\n(both curves visible)', fontsize=12)\n    ax1.legend(fontsize=11); ax1.grid(True, alpha=0.3, which='both')\n    ax1.set_ylim(1e3, 1e35)\n    # Right: linear scale, clipped\n    F_m_clip = np.clip(np.where(np.isfinite(F_m_raw), F_m_raw, 1e8), None, 1e8)\n    ax2.plot(F_c, 'b-', linewidth=2.5, label='Classical')\n    ax2.plot(F_m_clip, 'r-', linewidth=2.5, label='CNN stencil')\n    ax2.set_xlabel('time step', fontsize=12)\n    ax2.set_ylabel('free energy F[c]  (clipped at 1e8)', fontsize=12)\n    ax2.set_title('Free energy: linear scale\\n(CNN explosion visible)', fontsize=12)\n    ax2.legend(fontsize=11); ax2.grid(True, alpha=0.3)\n    ax2.set_ylim(4000, 1e8)\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'eval_free_energy.png'), dpi=120, bbox_inches='tight')\n    plt.close()\n\n    # ---- Figure 3: mass drift (log scale) ----\n    fig, ax = plt.subplots(figsize=(9, 5.5))\n    ax.axhline(0, color='b', linewidth=2.5, label='Classical (drift ~ 0)')\n    mm_drift = mm - mm[0]\n    mm_drift_plot = np.where(np.isfinite(mm_drift) & (np.abs(mm_drift) > 0), np.abs(mm_drift), np.nan)\n    ax.semilogy(mm_drift_plot, 'r-', linewidth=2.5, label='|CNN stencil drift|')\n    ax.set_xlabel('time step', fontsize=12)\n    ax.set_ylabel('|mass drift|  (log scale)', fontsize=12)\n    ax.set_title('Mass conservation: CNN destroys mass catastrophically', fontsize=12)\n    ax.legend(fontsize=11); ax.grid(True, alpha=0.3, which='both')\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'eval_mass.png'), dpi=120, bbox_inches='tight')\n    plt.close()\n\n    # ---- Figure 4: MSE growth (log scale) ----\n    fig, ax = plt.subplots(figsize=(9, 5.5))\n    ax.semilogy(mse_plot, 'k-', linewidth=2.5)\n    ax.set_xlabel('time step', fontsize=12)\n    ax.set_ylabel('MSE vs classical', fontsize=12)\n    ax.set_title('Rollout error growth (log scale)', fontsize=12)\n    ax.grid(True, alpha=0.3, which='both')\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'eval_mse.png'), dpi=120, bbox_inches='tight')\n    plt.close()\n    print(f\"\\nSaved 4 figures: eval_phase_separation.png, eval_free_energy.png (dual-panel), \"\n          f\"eval_mass.png, eval_mse.png\")\n\n\n# ============================================================\n# MAIN PIPELINE\n# ============================================================\n\ndef main():\n    print(\"=\"*60)\n    print(\"CAHN-HILLIARD CNN STENCIL PIPELINE\")\n    print(\"=\"*60)\n\n    # Generate data\n    print(\"\\n[1/4] Generating dataset...\")\n    t0 = time.time()\n    data = generate_dataset()\n    print(f\"  Dataset shape: {tuple(data.shape)}  ({time.time()-t0:.1f}s)\")\n    n_val = max(1, int(len(data) * 0.2))\n    train_data, val_data = data[n_val:], data[:n_val]\n    train_ds = CHDataset(train_data)\n    val_ds   = CHDataset(val_data)\n    train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)\n    val_loader   = DataLoader(val_ds,   batch_size=BATCH_SIZE, shuffle=False)\n    print(f\"  Train: {len(train_data)} traj ({len(train_ds)} pairs)\")\n    print(f\"  Val:   {len(val_data)} traj ({len(val_ds)} pairs)\")\n\n    # Model\n    print(\"\\n[2/4] Building model...\")\n    model = CNNStencil(stencil_size=5, channels=16, n_layers=3).to(DEVICE)\n    n_params = sum(p.numel() for p in model.parameters())\n    print(f\"  CNNStencil: {n_params:,} parameters\")\n\n    # Train\n    print(f\"\\n[3/4] Training ({N_EPOCHS} epochs)...\")\n    model = train_model(model, train_loader, val_loader)\n\n    # Load best and evaluate\n    print(f\"\\n[4/4] Evaluating...\")\n    model.load_state_dict(torch.load('cnn_stencil.pt', map_location=DEVICE, weights_only=True))\n    evaluate_and_plot(model, n_steps=500, out_dir='.')\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"DONE\")\n    print(\"=\"*60)\n    print(\"Next: implement the structure-preserving architecture in sp_stencil.py\")\n\n\nif __name__ == \"__main__\":\n    main()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\"\"\"\nStructure-preserving CNN stencil for Cahn-Hilliard — single-file Kaggle version.\n\nRun AFTER pipeline.py has produced cnn_stencil.pt. This file:\n  1. Defines the SP stencil (learns chemical potential; update uses fixed operators)\n  2. Trains it on the same data\n  3. Loads both CNN baseline and SP models\n  4. Produces 4 comparison figures (classical vs CNN vs SP)\n\nKey property: mass is conserved EXACTLY by construction (discrete divergence\nof a flux telescopes to 0 under periodic BC). Free energy dissipation holds\napproximately when mu_theta approximates the true chemical potential.\n\"\"\"\n\nimport torch\nimport torch.nn as nn\nimport torch.fft as fft\nfrom torch.utils.data import DataLoader, Dataset\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport time\nimport os\n\n# ============================================================\n# CONFIGURATION — must match pipeline.py\n# ============================================================\nMODE = 'kaggle'\n\nif MODE == 'test':\n    N_TRAJ     = 10\n    TRAJ_LEN   = 100\n    N_GRID     = 64\n    N_EPOCHS   = 20\n    BATCH_SIZE = 32\nelse:\n    N_TRAJ     = 50\n    TRAJ_LEN   = 500\n    N_GRID     = 128\n    N_EPOCHS   = 100\n    BATCH_SIZE = 64\n\nDT    = 1e-3\nM     = 1.0\nEPS   = 1.0\nLR    = 1e-3\nDEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n\nprint(f\"Mode: {MODE}\")\nprint(f\"Device: {DEVICE}\")\nprint(f\"Config: {N_TRAJ} traj x {TRAJ_LEN} steps, grid {N_GRID}x{N_GRID}, {N_EPOCHS} epochs\")\nprint()\n\n\n# ============================================================\n# Classical solver, free energy, mass (mirror pipeline.py)\n# ============================================================\n\ndef cahn_hilliard_solver(c0, n_steps, dt=DT, M=M, eps=EPS, device=DEVICE):\n    \"\"\"Semi-implicit Fourier solver for 2D Cahn-Hilliard (matches pipeline.py).\"\"\"\n    B, _, N, _ = c0.shape\n    c = c0.clone().to(device)\n    k = 2.0 * torch.pi * torch.fft.fftfreq(N, d=1.0).to(device)\n    kx, ky = torch.meshgrid(k, k, indexing='ij')\n    k2 = kx**2 + ky**2\n    k4 = k2**2\n    denom = 1.0 + dt * M * (eps ** 2) * k4\n    trajectory = [c]\n    for _ in range(n_steps):\n        fprime = c**3 - c\n        c_hat = fft.fft2(c)\n        fprime_hat = fft.fft2(fprime)\n        c_new_hat = (c_hat - dt * M * k2 * fprime_hat) / denom\n        c = fft.ifft2(c_new_hat).real\n        trajectory.append(c)\n    return torch.stack(trajectory, dim=0)\n\n\ndef free_energy(c, eps=EPS):\n    \"\"\"Ginzburg-Landau free energy F[c] = integral [(eps^2/2)|grad c|^2 + (1/4)(c^2-1)^2] dx.\"\"\"\n    cx = c[:, :, :, 1:] - c[:, :, :, :-1]\n    cy = c[:, :, 1:, :] - c[:, :, :-1, :]\n    grad_term = 0.5 * (eps**2) * ((cx**2).sum(dim=(-1,-2)) + (cy**2).sum(dim=(-1,-2)))\n    well_term = 0.25 * ((c**2 - 1)**2).sum(dim=(-1,-2))\n    return (grad_term + well_term).squeeze(-1)\n\n\ndef total_mass(c):\n    return c.sum(dim=(-1,-2,-3))\n\n\n# ============================================================\n# Data generation (same seed as pipeline.py -> same data)\n# ============================================================\n\ndef generate_dataset(n_traj=N_TRAJ, traj_len=TRAJ_LEN, N=N_GRID, dt=DT, M=M, eps=EPS, seed=0):\n    torch.manual_seed(seed)\n    trajectories = []\n    for _ in range(n_traj):\n        c0 = 0.05 * torch.randn(1, 1, N, N)\n        traj = cahn_hilliard_solver(c0, n_steps=traj_len, dt=dt, M=M, eps=eps)\n        trajectories.append(traj[:, 0])\n    return torch.stack(trajectories, dim=0)\n\n\nclass CHDataset(Dataset):\n    def __init__(self, trajectories):\n        self.traj = trajectories\n        n_traj, T = trajectories.shape[:2]\n        self.indices = [(i, t) for i in range(n_traj) for t in range(T - 1)]\n    def __len__(self):\n        return len(self.indices)\n    def __getitem__(self, idx):\n        i, t = self.indices[idx]\n        return self.traj[i, t], self.traj[i, t + 1]\n\n\n# ============================================================\n# 2. STRUCTURE-PRESERVING CNN STENCIL  (the contribution)\n# ============================================================\n\nclass SPStencil(nn.Module):\n    \"\"\"\n    Structure-preserving CNN stencil for Cahn-Hilliard.\n\n    Architecture:\n        mu_theta(c) = CNN(c)                  # learned chemical potential (scalar field)\n        J           = -M * grad_h(mu_theta)   # Fick's law flux (fixed discrete gradient)\n        c^{n+1}     = c^n - dt * div_h(J)     # update (fixed discrete divergence)\n\n    Properties (provable, see paper Sec. 3):\n      (i)  Mass conservation:  sum(c^{n+1}) = sum(c^n)  exactly.\n            Proof: sum(div_h J) = 0 by telescoping under periodic BC.\n      (ii) Free-energy dissipation: F[c^{n+1}] <= F[c^n] when\n           mu_theta approximates the true chemical potential\n           delta F / delta c = -eps^2 lap(c) + c^3 - c. Holds approximately.\n\n    The CNN has the same architecture and parameter count as the vanilla\n    CNNStencil baseline, so any rollout improvement is due to structure,\n    not capacity.\n    \"\"\"\n    def __init__(self, stencil_size=5, channels=16, n_layers=3):\n        super().__init__()\n        pad = stencil_size // 2\n        layers = []\n        in_ch = 1\n        for _ in range(n_layers):\n            layers.append(nn.Conv2d(in_ch, channels, stencil_size, padding=pad))\n            layers.append(nn.GELU())\n            in_ch = channels\n        layers.append(nn.Conv2d(in_ch, 1, stencil_size, padding=pad))\n        self.mu_net = nn.Sequential(*layers)\n\n    def chemical_potential(self, c):\n        return self.mu_net(c)\n\n    def forward(self, c, dt=DT, M=M):\n        # Learned chemical potential\n        mu = self.mu_net(c)\n        # Forward-difference gradient on periodic grid (via torch.roll)\n        grad_mu_x = torch.roll(mu, -1, dims=-1) - mu   # d mu / d x at (i+1/2, j)\n        grad_mu_y = torch.roll(mu, -1, dims=-2) - mu   # d mu / d y at (i, j+1/2)\n        # Fick's law flux: J = -M grad mu\n        Jx = -M * grad_mu_x\n        Jy = -M * grad_mu_y\n        # Backward-difference divergence (adjoint of forward gradient -> mass-conserving)\n        div_J = (Jx - torch.roll(Jx, 1, dims=-1)) + (Jy - torch.roll(Jy, 1, dims=-2))\n        # CH update: dc/dt = div(M grad mu) = -div(J)\n        return c - dt * div_J\n\n\n# ============================================================\n# Vanilla CNN baseline (re-defined so this file is self-contained)\n# ============================================================\n\nclass CNNStencil(nn.Module):\n    \"\"\"Vanilla CNN stencil. Predicts c(t+dt) from c(t). No structure preservation.\"\"\"\n    def __init__(self, stencil_size=5, channels=16, n_layers=3):\n        super().__init__()\n        pad = stencil_size // 2\n        layers = []\n        in_ch = 1\n        for _ in range(n_layers):\n            layers.append(nn.Conv2d(in_ch, channels, stencil_size, padding=pad))\n            layers.append(nn.GELU())\n            in_ch = channels\n        layers.append(nn.Conv2d(in_ch, 1, stencil_size, padding=pad))\n        self.net = nn.Sequential(*layers)\n    def forward(self, c):\n        return self.net(c)\n\n\ndef rollout(model, c0, n_steps):\n    trajectory = [c0]\n    c = c0\n    with torch.no_grad():\n        for _ in range(n_steps):\n            c = model(c)\n            trajectory.append(c)\n    return torch.stack(trajectory, dim=0)\n\n\n# ============================================================\n# Training (identical to pipeline.py, except saves to sp_stencil.pt)\n# ============================================================\n\ndef train_model(model, train_loader, val_loader, n_epochs=N_EPOCHS, lr=LR,\n                device=DEVICE, save_path='sp_stencil.pt'):\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=n_epochs)\n    best_val = float('inf')\n    for epoch in range(n_epochs):\n        t0 = time.time()\n        model.train()\n        train_loss, n_b = 0.0, 0\n        for c_t, c_tp1 in train_loader:\n            c_t, c_tp1 = c_t.to(device), c_tp1.to(device)\n            pred = model(c_t)\n            loss = ((pred - c_tp1) ** 2).mean()\n            optimizer.zero_grad(); loss.backward(); optimizer.step()\n            train_loss += loss.item(); n_b += 1\n        train_loss /= n_b\n        model.eval()\n        val_loss, n_v = 0.0, 0\n        with torch.no_grad():\n            for c_t, c_tp1 in val_loader:\n                c_t, c_tp1 = c_t.to(device), c_tp1.to(device)\n                pred = model(c_t)\n                val_loss += ((pred - c_tp1) ** 2).mean().item(); n_v += 1\n        val_loss /= n_v\n        scheduler.step()\n        if val_loss < best_val:\n            best_val = val_loss\n            torch.save(model.state_dict(), save_path)\n        print(f\"Epoch {epoch+1:3d}/{n_epochs}  train={train_loss:.4e}  val={val_loss:.4e}  \"\n              f\"lr={scheduler.get_last_lr()[0]:.2e}  ({time.time()-t0:.1f}s)\")\n    print(f\"\\nBest val loss: {best_val:.4e}\")\n    return model\n\n\n# ============================================================\n# Sanity check: verify mass conservation property\n# ============================================================\n\ndef verify_mass_conservation(model, n_tests=3):\n    \"\"\"Empirically confirm that the SP update conserves mass to machine precision.\"\"\"\n    print(\"\\n--- Mass conservation sanity check ---\")\n    max_drift = 0.0\n    for _ in range(n_tests):\n        c = 0.1 * torch.randn(1, 1, N_GRID, N_GRID, device=DEVICE)\n        m0 = c.sum().item()\n        c_next = model(c)\n        m1 = c_next.sum().item()\n        drift = abs(m1 - m0)\n        max_drift = max(max_drift, drift)\n        print(f\"  mass before={m0:.6f}  after={m1:.6f}  drift={drift:.2e}\")\n    print(f\"  Max drift across {n_tests} tests: {max_drift:.2e}\")\n    print(f\"  (Expected: ~1e-7, single-precision roundoff. Vanilla CNN drifts ~1e-3.)\\n\")\n\n\n# ============================================================\n# Comparison evaluation (the headline results)\n# ============================================================\n\ndef fmt(x):\n    if not np.isfinite(x):\n        return \"inf\"\n    if abs(x) < 1e6 and abs(x) >= 1e-3:\n        return f\"{x:.3f}\"\n    return f\"{x:.2e}\"\n\n\ndef compare_and_plot(cnn_model, sp_model, n_steps=500, out_dir='.'):\n    \"\"\"Three-way rollout comparison: classical vs vanilla CNN vs SP.\"\"\"\n    N = N_GRID\n    torch.manual_seed(999)\n    c0 = 0.2 * torch.randn(1, 1, N, N)\n\n    print(\"Computing classical trajectory (ground truth)...\")\n    with torch.no_grad():\n        classical_traj = cahn_hilliard_solver(c0, n_steps=n_steps)[:, 0].cpu()\n    print(\"Computing vanilla CNN rollout...\")\n    with torch.no_grad():\n        cnn_traj = rollout(cnn_model, c0.to(DEVICE), n_steps=n_steps).cpu()[:, 0]\n    print(\"Computing SP stencil rollout...\")\n    with torch.no_grad():\n        sp_traj = rollout(sp_model, c0.to(DEVICE), n_steps=n_steps).cpu()[:, 0]\n\n    # Metrics\n    F_c   = free_energy(classical_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    F_cnn = free_energy(cnn_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    F_sp  = free_energy(sp_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n\n    mc    = total_mass(classical_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    mcnn  = total_mass(cnn_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n    msp   = total_mass(sp_traj.reshape(-1, 1, N, N)).reshape(-1).numpy()\n\n    mse_cnn = ((cnn_traj - classical_traj)**2).mean(dim=(-1,-2,-3)).numpy()\n    mse_sp  = ((sp_traj  - classical_traj)**2).mean(dim=(-1,-2,-3)).numpy()\n\n    # Print summary table\n    print(f\"\\n{'='*100}\")\n    print(f\"COMPARISON ROLLOUT RESULTS ({n_steps} steps, IC amplitude 0.2)\")\n    print(f\"{'='*100}\")\n    print(f\"{'step':>6} {'F_cl':>10} {'F_cnn':>14} {'F_sp':>12}  | \"\n          f\"{'dm_cl':>10} {'dm_cnn':>14} {'dm_sp':>12}  | \"\n          f\"{'mse_cnn':>12} {'mse_sp':>12}\")\n    for t in [0, n_steps//10, n_steps//4, n_steps//2, 3*n_steps//4, n_steps]:\n        print(f\"{t:>6} {fmt(F_c[t]):>10} {fmt(F_cnn[t]):>14} {fmt(F_sp[t]):>12}  | \"\n              f\"{fmt(mc[t]-mc[0]):>10} {fmt(mcnn[t]-mcnn[0]):>14} {fmt(msp[t]-msp[0]):>12}  | \"\n              f\"{fmt(mse_cnn[t]):>12} {fmt(mse_sp[t]):>12}\")\n\n    # === FIGURE 1: free energy (HEADLINE) ===\n    fig, ax = plt.subplots(figsize=(10, 6))\n    ax.semilogy(np.arange(len(F_c))+1, np.maximum(F_c, 1e-3),\n                'b-', linewidth=2.5, label='Classical solver (ground truth)')\n    F_cnn_plot = np.where(np.isfinite(F_cnn) & (F_cnn > 0), F_cnn, np.nan)\n    F_sp_plot  = np.where(np.isfinite(F_sp)  & (F_sp  > 0), F_sp,  np.nan)\n    ax.semilogy(F_cnn_plot, 'r-', linewidth=2.5, label='Vanilla CNN (baseline)')\n    ax.semilogy(F_sp_plot,  'g-', linewidth=2.5, label='Structure-preserving (ours)')\n    ax.set_xlabel('time step', fontsize=13)\n    ax.set_ylabel('free energy F[c]  (log scale)', fontsize=13)\n    ax.set_title('Free energy: classical vs vanilla CNN vs structure-preserving\\n'\n                 'Vanilla CNN explodes; SP follows the dissipation law', fontsize=12)\n    ax.legend(fontsize=12, loc='best')\n    ax.grid(True, alpha=0.3, which='both')\n    ax.set_ylim(1e3, 1e35)\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'comparison_free_energy.png'),\n                dpi=120, bbox_inches='tight')\n    plt.close()\n\n    # === FIGURE 2: mass conservation ===\n    fig, ax = plt.subplots(figsize=(10, 6))\n    ax.axhline(1e-15, color='b', linewidth=2.5, label='Classical (drift = 0)')\n    mcnn_drift = np.where(np.isfinite(mcnn - mcnn[0]), np.abs(mcnn - mcnn[0]), np.nan)\n    msp_drift  = np.abs(msp - msp[0])\n    ax.semilogy(np.maximum(mcnn_drift, 1e-15), 'r-', linewidth=2.5,\n                label='|Vanilla CNN drift|')\n    ax.semilogy(np.maximum(msp_drift, 1e-15), 'g-', linewidth=2.5,\n                label='|SP drift|')\n    ax.set_xlabel('time step', fontsize=13)\n    ax.set_ylabel('|mass drift|  (log scale)', fontsize=13)\n    ax.set_title('Mass conservation: vanilla CNN destroys mass; SP conserves exactly',\n                 fontsize=12)\n    ax.legend(fontsize=12, loc='best')\n    ax.grid(True, alpha=0.3, which='both')\n    ax.set_ylim(1e-16, 1e35)\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'comparison_mass.png'),\n                dpi=120, bbox_inches='tight')\n    plt.close()\n\n    # === FIGURE 3: MSE ===\n    fig, ax = plt.subplots(figsize=(10, 6))\n    mse_cnn_plot = np.where(np.isfinite(mse_cnn) & (mse_cnn > 0), mse_cnn, np.nan)\n    mse_sp_plot  = np.where(np.isfinite(mse_sp)  & (mse_sp  > 0), mse_sp,  np.nan)\n    ax.semilogy(mse_cnn_plot, 'r-', linewidth=2.5, label='Vanilla CNN')\n    ax.semilogy(mse_sp_plot,  'g-', linewidth=2.5, label='Structure-preserving (ours)')\n    ax.set_xlabel('time step', fontsize=13)\n    ax.set_ylabel('MSE vs classical  (log scale)', fontsize=13)\n    ax.set_title('Rollout error: SP stays bounded; vanilla CNN diverges',\n                 fontsize=12)\n    ax.legend(fontsize=12, loc='best')\n    ax.grid(True, alpha=0.3, which='both')\n    ax.set_ylim(1e-12, 1e15)\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'comparison_mse.png'),\n                dpi=120, bbox_inches='tight')\n    plt.close()\n\n    # === FIGURE 4: phase separation (3 rows) ===\n    fig, axes = plt.subplots(3, 4, figsize=(14, 9))\n    times = [0, n_steps//10, n_steps//4, n_steps//2]\n    for j, t in enumerate(times):\n        axes[0, j].imshow(classical_traj[t, 0].numpy(),\n                          cmap='RdBu_r', vmin=-1, vmax=1)\n        axes[0, j].set_title(f't = {t}')\n        axes[1, j].imshow(np.clip(cnn_traj[t, 0].numpy(), -1, 1),\n                          cmap='RdBu_r', vmin=-1, vmax=1)\n        axes[1, j].set_title(f't = {t}')\n        axes[2, j].imshow(np.clip(sp_traj[t, 0].numpy(), -1, 1),\n                         cmap='RdBu_r', vmin=-1, vmax=1)\n        axes[2, j].set_title(f't = {t}')\n        for ax in axes[:, j]:\n            ax.set_xticks([]); ax.set_yticks([])\n    axes[0, 0].set_ylabel('Classical',     fontsize=13)\n    axes[1, 0].set_ylabel('Vanilla CNN',   fontsize=13)\n    axes[2, 0].set_ylabel('SP (ours)',     fontsize=13)\n    plt.suptitle('Phase separation: classical vs vanilla CNN vs structure-preserving',\n                 y=1.01, fontsize=13)\n    plt.tight_layout()\n    plt.savefig(os.path.join(out_dir, 'comparison_phase_separation.png'),\n                dpi=120, bbox_inches='tight')\n    plt.close()\n\n    print(f\"\\nSaved 4 comparison figures:\")\n    print(f\"  comparison_free_energy.png\")\n    print(f\"  comparison_mass.png\")\n    print(f\"  comparison_mse.png\")\n    print(f\"  comparison_phase_separation.png\")\n\n\n# ============================================================\n# MAIN PIPELINE\n# ============================================================\n\ndef main():\n    print(\"=\"*70)\n    print(\"STRUCTURE-PRESERVING CNN STENCIL PIPELINE\")\n    print(\"=\"*70)\n\n    # 1. Generate dataset (same seed -> same data as pipeline.py)\n    print(\"\\n[1/5] Generating dataset...\")\n    t0 = time.time()\n    data = generate_dataset()\n    print(f\"  Dataset shape: {tuple(data.shape)}  ({time.time()-t0:.1f}s)\")\n    n_val = max(1, int(len(data) * 0.2))\n    train_data, val_data = data[n_val:], data[:n_val]\n    train_ds = CHDataset(train_data)\n    val_ds   = CHDataset(val_data)\n    train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)\n    val_loader   = DataLoader(val_ds,   batch_size=BATCH_SIZE, shuffle=False)\n    print(f\"  Train: {len(train_data)} traj ({len(train_ds)} pairs)\")\n    print(f\"  Val:   {len(val_data)} traj ({len(val_ds)} pairs)\")\n\n    # 2. Build SP model\n    print(\"\\n[2/5] Building SP model...\")\n    sp_model = SPStencil(stencil_size=5, channels=16, n_layers=3).to(DEVICE)\n    n_params = sum(p.numel() for p in sp_model.parameters())\n    print(f\"  SPStencil: {n_params:,} parameters\")\n    print(f\"  (Same architecture as CNNStencil: learned chemical potential + fixed operators)\")\n\n    # 3. Sanity check mass conservation BEFORE training\n    print(\"\\n[3/5] Mass conservation sanity check (untrained model)...\")\n    verify_mass_conservation(sp_model, n_tests=3)\n\n    # 4. Train SP model\n    print(f\"\\n[4/5] Training SP model ({N_EPOCHS} epochs)...\")\n    sp_model = train_model(sp_model, train_loader, val_loader,\n                          save_path='sp_stencil.pt')\n\n    # Re-verify mass conservation AFTER training\n    print(\"\\n[4b/5] Mass conservation after training (should still hold)...\")\n    sp_model.load_state_dict(torch.load('sp_stencil.pt',\n                                        map_location=DEVICE, weights_only=True))\n    sp_model.eval()\n    verify_mass_conservation(sp_model, n_tests=3)\n\n    # 5. Load CNN baseline and run comparison\n    print(f\"\\n[5/5] Loading CNN baseline and running three-way comparison...\")\n    try:\n        cnn_model = CNNStencil(stencil_size=5, channels=16, n_layers=3).to(DEVICE)\n        cnn_model.load_state_dict(torch.load('cnn_stencil.pt',\n                                             map_location=DEVICE, weights_only=True))\n        cnn_model.eval()\n        print(\"  Loaded cnn_stencil.pt\")\n    except FileNotFoundError:\n        print(\"  ERROR: cnn_stencil.pt not found. Run pipeline.py first to train the baseline.\")\n        return\n\n    compare_and_plot(cnn_model, sp_model, n_steps=500, out_dir='.')\n\n    print(\"\\n\" + \"=\"*70)\n    print(\"DONE\")\n    print(\"=\"*70)\n    print(\"All comparison figures saved. Next: write the paper draft.\")\n\n\nif __name__ == \"__main__\":\n    main()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# === Package outputs for download ===\nimport os, shutil\nout_dir = '/kaggle/working/outputs'\nos.makedirs(out_dir, exist_ok=True)\n\nfiles_to_save = [\n    'cnn_stencil.pt', 'sp_stencil.pt',\n    'comparison_free_energy.png', 'comparison_mass.png',\n    'comparison_mse.png', 'comparison_phase_separation.png',\n    'eval_phase_separation.png', 'eval_free_energy.png',\n    'eval_mass.png', 'eval_mse.png',\n]\nfor f in files_to_save:\n    src = os.path.join('/kaggle/working', f)\n    if os.path.exists(src):\n        shutil.copy(src, os.path.join(out_dir, f))\n        print(f'  copied: {f} ({os.path.getsize(src)} bytes)')\n    else:\n        print(f'  MISSING: {f}')\n\nshutil.make_archive('/kaggle/working/outputs_zip', 'zip', out_dir)\nprint('\\nZip created: /kaggle/working/outputs_zip.zip')\nprint('Click the output file on the right sidebar to download.')\nprint('All 4 comparison_*.png files are the ones you need for the paper.')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}